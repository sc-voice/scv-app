#!/usr/bin/env swift

import Foundation

enum VersionBumpType: String {
    case major, minor, patch

    func bump(version: String) -> String {
        let parts = version.split(separator: ".", omittingEmptySubsequences: false).map { String($0) }
        let calendar = Calendar.current
        let currentYear = calendar.component(.year, from: Date())
        let year = currentYear % 100

        // Calculate month: two weeks from now (2-digit)
        let twoWeeksFromNow = calendar.date(byAdding: .day, value: 14, to: Date()) ?? Date()
        let month = calendar.component(.month, from: twoWeeksFromNow)

        // Extract old year and month from current version
        let oldYear = parts.count > 0 ? (Int(parts[0]) ?? 0) : 0
        let oldMonth = parts.count > 1 ? (Int(parts[1]) ?? 0) : 0
        var patch = parts.count > 2 ? (Int(parts[2]) ?? 0) : 0

        // Reset patch if year or month changed
        if year != oldYear || month != oldMonth {
            patch = 0
        } else {
            // Only increment patch if year and month are the same
            switch self {
            case .major, .minor:
                patch = 0
            case .patch:
                patch += 1
            }
        }

        return "\(year).\(String(format: "%02d", month)).\(patch)"
    }

    func bumpMarketing(version: String) -> String {
        let calendar = Calendar.current
        let currentYear = calendar.component(.year, from: Date())
        let year = currentYear % 100

        // Calculate month: two weeks from now (2-digit)
        let twoWeeksFromNow = calendar.date(byAdding: .day, value: 14, to: Date()) ?? Date()
        let month = calendar.component(.month, from: twoWeeksFromNow)

        return "\(year).\(String(format: "%02d", month))"
    }
}

let currentDir = FileManager.default.currentDirectoryPath
let versionSwiftPath = currentDir + "/scv-core/Sources/Version.swift"
let pbxprojPaths = [
    currentDir + "/scv-ios/scv-ios.xcodeproj/project.pbxproj",
    currentDir + "/scv-demo-ios/scv-demo-ios.xcodeproj/project.pbxproj"
]

guard FileManager.default.fileExists(atPath: versionSwiftPath) else {
    print("Error: Version.swift not found at \(versionSwiftPath)")
    exit(1)
}

for pbxprojPath in pbxprojPaths {
    guard FileManager.default.fileExists(atPath: pbxprojPath) else {
        print("Warning: project.pbxproj not found at \(pbxprojPath)")
        continue
    }
}

// Parse arguments
let args = Array(CommandLine.arguments.dropFirst())
guard args.count > 0 else {
    print("Usage: version.swift [major|minor|patch]")
    exit(1)
}

guard let bumpType = VersionBumpType(rawValue: args[0]) else {
    print("Error: invalid version type '\(args[0])'. Use 'major', 'minor', or 'patch'")
    exit(1)
}

do {
    // Read current version from Version.swift
    var versionSwiftContent = try String(contentsOfFile: versionSwiftPath, encoding: .utf8)

    // Extract buildVersion using regex: public let buildVersion = "X.YYZZ.Z"
    let buildVersionPattern = "public let buildVersion = \"([\\d.]+)\""
    let buildVersionRegex = try NSRegularExpression(pattern: buildVersionPattern, options: [])
    let buildVersionMatches = buildVersionRegex.matches(in: versionSwiftContent, options: [], range: NSRange(versionSwiftContent.startIndex..., in: versionSwiftContent))

    guard let buildVersionMatch = buildVersionMatches.first,
          let buildVersionRange = Range(buildVersionMatch.range(at: 1), in: versionSwiftContent) else {
        print("Error: Could not find buildVersion in Version.swift")
        exit(1)
    }

    let currentBuildVersion = String(versionSwiftContent[buildVersionRange])
    let newBuildVersion = bumpType.bump(version: currentBuildVersion)

    // Extract marketingVersion using regex: public let marketingVersion = "X.Y.Z"
    let marketingVersionPattern = "public let marketingVersion = \"([\\d.]+)\""
    let marketingVersionRegex = try NSRegularExpression(pattern: marketingVersionPattern, options: [])
    let marketingVersionMatches = marketingVersionRegex.matches(in: versionSwiftContent, options: [], range: NSRange(versionSwiftContent.startIndex..., in: versionSwiftContent))

    guard let marketingVersionMatch = marketingVersionMatches.first,
          let marketingVersionRange = Range(marketingVersionMatch.range(at: 1), in: versionSwiftContent) else {
        print("Error: Could not find marketingVersion in Version.swift")
        exit(1)
    }

    let currentMarketingVersion = String(versionSwiftContent[marketingVersionRange])
    let newMarketingVersion = bumpType.bumpMarketing(version: currentMarketingVersion)

    // Update buildVersion and marketingVersion in Version.swift
    versionSwiftContent.replaceSubrange(buildVersionRange, with: newBuildVersion)
    versionSwiftContent.replaceSubrange(marketingVersionRange, with: newMarketingVersion)
    try versionSwiftContent.write(toFile: versionSwiftPath, atomically: true, encoding: .utf8)

    // Update pbxproj files
    let buildVersionPbxPattern = "CURRENT_PROJECT_VERSION = ([\\d.]+);"
    let buildVersionPbxRegex = try NSRegularExpression(pattern: buildVersionPbxPattern, options: [])
    let marketingVersionPbxPattern = "MARKETING_VERSION = ([\\d.]+);"
    let marketingVersionPbxRegex = try NSRegularExpression(pattern: marketingVersionPbxPattern, options: [])

    for pbxprojPath in pbxprojPaths {
        guard FileManager.default.fileExists(atPath: pbxprojPath) else {
            continue
        }

        var pbxContent = try String(contentsOfFile: pbxprojPath, encoding: .utf8)

        // Update CURRENT_PROJECT_VERSION
        let buildVersionMatches = buildVersionPbxRegex.matches(in: pbxContent, options: [], range: NSRange(pbxContent.startIndex..., in: pbxContent))
        if !buildVersionMatches.isEmpty {
            for match in buildVersionMatches.reversed() {
                if let versionRange = Range(match.range(at: 1), in: pbxContent) {
                    pbxContent.replaceSubrange(versionRange, with: newBuildVersion)
                }
            }
        }

        // Sync MARKETING_VERSION from Version.swift
        let marketingVersionMatches = marketingVersionPbxRegex.matches(in: pbxContent, options: [], range: NSRange(pbxContent.startIndex..., in: pbxContent))
        if !marketingVersionMatches.isEmpty {
            for match in marketingVersionMatches.reversed() {
                if let versionRange = Range(match.range(at: 1), in: pbxContent) {
                    pbxContent.replaceSubrange(versionRange, with: newMarketingVersion)
                }
            }
        }

        try pbxContent.write(toFile: pbxprojPath, atomically: true, encoding: .utf8)
    }

    print("✓ Build version bumped to \(newBuildVersion)")
    print("✓ Marketing version updated to \(newMarketingVersion)")

} catch {
    print("Error: \(error.localizedDescription)")
    exit(1)
}
