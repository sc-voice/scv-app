#!/bin/bash

# Thin wrapper that calls scv-build executable
# The actual build logic is now in scv-build Swift package

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PROJECT_ROOT

BUILD_EXEC="$PROJECT_ROOT/scv-build/.build/debug/scv-build-cli"

# Build scv-build only if executable doesn't exist
if [ ! -f "$BUILD_EXEC" ]; then
  echo "Building scv-build..."
  (cd "$PROJECT_ROOT/scv-build" && swift build 2>&1 | grep -E "(error|warning:|Build complete)" || true)
fi

# Run scv-build-cli with forwarded arguments
"$BUILD_EXEC" "$@"
